<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#080808">
<title>Nex-linkgen</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root {
  color-scheme: dark;
  --bg: #080808;
  --surface: #101010;
  --surface-raised: #171717;
  --line: #343434;
  --line-soft: #252525;
  --text: #f5f5f5;
  --muted: #a0a0a0;
  --subtle: #707070;
  --radius: 24px;
  --ease: cubic-bezier(.2,.8,.2,1);
}
* { box-sizing: border-box; }
html { min-height: 100%; background: var(--bg); }
body {
  margin: 0;
  min-height: 100vh;
  background:
    radial-gradient(ellipse at 50% -18%, rgba(255,255,255,.075), transparent 48%),
    var(--bg);
  color: var(--text);
  font: 13px/1.6 "JetBrains Mono", ui-monospace, SFMono-Regular, Consolas, monospace;
  letter-spacing: 0;
}
button, input { font: inherit; }
button { color: inherit; }
button:focus-visible, input:focus-visible, a:focus-visible {
  outline: 2px solid #eee;
  outline-offset: 3px;
}
.app { width: min(1180px, calc(100% - 28px)); margin: 0 auto; padding: 30px 0 44px; }
.topbar { display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:28px; }
.brand { display:flex; align-items:center; gap:11px; min-width:0; }
.brand-mark {
  display:grid; place-items:center; width:36px; height:36px; flex:none;
  border:1px solid #555; border-radius:12px; background:linear-gradient(145deg,#222,#090909);
  font-size:14px; font-weight:650; letter-spacing:-.07em;
}
.brand-name { font-size:14px; font-weight:600; letter-spacing:-.045em; }
.brand-sub { color:var(--muted); font-size:12px; margin-top:1px; }
.status { display:flex; align-items:center; gap:7px; color:var(--muted); font-size:12px; white-space:nowrap; }
.status-dot { width:6px; height:6px; border-radius:50%; background:#ddd; box-shadow:0 0 0 3px #222; }
.hero { padding: 12px 0 26px; }
.eyebrow { color:#aaa; font-size:11px; font-weight:600; letter-spacing:.14em; text-transform:uppercase; margin-bottom:12px; }
h1 { margin:0; font-size:clamp(28px,4.5vw,46px); line-height:1.15; letter-spacing:-.075em; font-weight:600; }
.hero p { max-width:560px; margin:14px 0 0; color:var(--muted); font-size:14px; }
.panel {
  border:1px solid var(--line); border-radius:var(--radius);
  background:linear-gradient(145deg,rgba(255,255,255,.025),transparent 42%),var(--surface);
  padding:20px; margin-top:14px; box-shadow:0 16px 40px rgba(0,0,0,.12);
}
.panel-heading { display:flex; justify-content:space-between; align-items:flex-start; gap:16px; margin-bottom:16px; }
.panel-title { font-size:15px; font-weight:600; letter-spacing:-.025em; }
.panel-description { color:var(--muted); font-size:11px; margin-top:4px; }
.section-index { color:#777; font-size:11px; font-variant-numeric:tabular-nums; padding-top:3px; }
.providers { display:grid; grid-template-columns:repeat(5,minmax(0,1fr)); gap:8px; }
.provider {
  min-width:0; display:flex; align-items:center; gap:8px; padding:10px 9px;
  border:1px solid var(--line-soft); border-radius:12px; background:#0c0c0c;
  cursor:pointer; transition:background .18s var(--ease),border-color .18s var(--ease),transform .18s var(--ease);
}
.provider:hover { background:#171717; border-color:#505050; }
.provider:active { transform:scale(.985); }
.provider:has(input:checked) { border-color:#777; background:#191919; }
.provider input { width:14px; height:14px; margin:0; flex:none; accent-color:#f4f4f4; }
.provider span { min-width:0; color:#ddd; font-size:10px; line-height:1.4; overflow-wrap:anywhere; }
.provider-actions { display:flex; flex-wrap:wrap; gap:7px; }
.provider-heading-right { display:flex; align-items:center; gap:14px; }
.provider-footer { display:flex; align-items:center; justify-content:space-between; gap:12px; margin-top:12px; }
.count-field { grid-column:span 2; }
.count-control { display:flex; align-items:stretch; gap:9px; }
.count-control input { flex:1; width:0; }
.count-control #generate { flex:none; min-width:180px; min-height:45px; padding:10px 17px; border-radius:12px; font-size:12px; font-weight:600; letter-spacing:-.02em; white-space:nowrap; }
.count-control #generate:active { transform:scale(.98); }
.btn {
  display:inline-flex; align-items:center; justify-content:center; gap:7px; min-height:36px;
  padding:8px 12px; border:1px solid #414141; border-radius:11px; background:#191919;
  color:#f4f4f4; cursor:pointer; font-size:11px; font-weight:500;
  transition:background .18s var(--ease),border-color .18s var(--ease),transform .12s ease;
}
.btn:hover { background:#252525; border-color:#666; }
.btn:active { transform:scale(.975); }
.btn.primary { background:#f0f0f0; color:#090909; border-color:#f0f0f0; }
.btn.primary:hover { background:#d6d6d6; }
.btn.quiet { background:transparent; }
.btn:disabled { opacity:.4; cursor:not-allowed; transform:none; }
.fields { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px; }
.field { min-width:0; }
.field label { display:block; margin-bottom:7px; color:#c4c4c4; font-size:12px; }
.field input {
  display:block; width:100%; min-width:0; height:41px; padding:0 12px;
  border:1px solid #3b3b3b; border-radius:11px; background:#090909; color:#f5f5f5;
  transition:border-color .18s var(--ease),background .18s var(--ease);
}
.field input:hover { border-color:#555; }
.field input:focus { border-color:#aaa; outline:none; background:#0d0d0d; }
.field-note { margin-top:6px; color:#777; font-size:11px; }
.helper { color:var(--muted); font-size:12px; }
.toolbar { display:flex; justify-content:space-between; align-items:center; gap:12px; flex-wrap:wrap; margin-bottom:12px; }
.result-count { color:var(--muted); font-size:12px; }
.result-count strong { color:#f4f4f4; font-weight:600; }
.result-actions { display:flex; gap:7px; flex-wrap:wrap; }
.results {
  display:grid; gap:7px; max-height:570px; overflow:auto; padding-right:2px;
  scrollbar-color:#444 transparent; scrollbar-width:thin;
}
.result {
  display:flex; align-items:center; gap:10px; min-width:0; padding:10px 11px;
  border:1px solid #292929; border-radius:11px; background:#0b0b0b;
}
.result-number { flex:none; width:42px; color:#858585; font:11px ui-monospace,SFMono-Regular,Consolas,monospace; }
.result-url { flex:1; min-width:0; overflow-wrap:anywhere; color:#d6d6d6; text-decoration:none; font:11px/1.45 ui-monospace,SFMono-Regular,Consolas,monospace; }
.result-url:hover { color:white; text-decoration:underline; }
.copy-one { flex:none; min-height:30px; padding:5px 9px; font-size:11px; }
.pager { display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; margin-top:14px; }
.pager-controls { display:flex; align-items:center; gap:7px; }
.page-label { min-width:90px; text-align:center; color:#aaa; font-size:12px; font-variant-numeric:tabular-nums; }
.empty { padding:28px 14px; border:1px dashed #353535; border-radius:14px; color:#858585; text-align:center; font-size:12px; }
.notice { color:#888; font-size:11px; line-height:1.55; margin-top:12px; }
.toast { position:fixed; z-index:10; left:50%; bottom:22px; transform:translate(-50%,12px); opacity:0; pointer-events:none;
  padding:10px 14px; border:1px solid #555; border-radius:12px; background:#202020; color:#fff; font-size:12px;
  box-shadow:0 10px 30px #0008; transition:opacity .2s ease,transform .2s var(--ease);
}
.toast.show { opacity:1; transform:translate(-50%,0); }
footer { display:flex; justify-content:space-between; gap:12px; padding:22px 3px 0; color:#696969; font-size:11px; }
[hidden] { display:none !important; }
@media (max-width:850px) {
  .providers { grid-template-columns:repeat(3,minmax(0,1fr)); }
  .fields { grid-template-columns:repeat(2,minmax(0,1fr)); }
}
@media (max-width:520px) {
  .app { width:calc(100% - 20px); padding-top:18px; }
  .topbar { margin-bottom:20px; }
  .hero { padding-bottom:17px; }
  .panel { padding:14px; border-radius:20px; }
  .providers { grid-template-columns:repeat(2,minmax(0,1fr)); gap:7px; }
  .provider { padding:10px 8px; }
  .fields { grid-template-columns:1fr; gap:11px; }
  .count-field { grid-column:span 2; }
  .provider-heading-right { align-items:flex-end; flex-direction:column; gap:4px; }
  .provider-footer { align-items:flex-start; }
  .toolbar { align-items:flex-start; }
  .result { gap:7px; padding:9px; }
  .result-number { width:31px; font-size:10px; }
  .result-url { font-size:10px; }
  .copy-one { padding:5px 7px; }
  footer { flex-direction:column; }
}
@media (prefers-reduced-motion:reduce) {
  *,*::before,*::after { scroll-behavior:auto !important; transition:none !important; animation:none !important; }
}
</style>
</head>
<body>
<div class="app">
  <header class="topbar">
    <div class="brand">
      <div class="brand-mark" aria-hidden="true">N/</div>
      <div>
        <div class="brand-name">Nex-linkgen</div>
        <div class="brand-sub">GitHub URL generator</div>
      </div>
    </div>
    <div class="status"><span class="status-dot"></span> Local tool · No account needed</div>
  </header>

  <section class="hero">
    <div class="eyebrow">Developer utility</div>
    <h1>One source.<br>Multiple links.</h1>
    <p>Build numbered CDN URLs for a GitHub file, choose the providers you need, and copy or export your results.</p>
  </section>

  <section class="panel" aria-labelledby="provider-title">
    <div class="panel-heading">
      <div>
        <div class="panel-title" id="provider-title">CDN providers</div>
        <div class="panel-description">Choose one, several, or all providers.</div>
      </div>
      <div class="provider-heading-right">
        <div class="helper" id="selectionInfo">0 providers selected</div>
        <div class="section-index">01 / 03</div>
      </div>
    </div>
    <div class="providers" id="providers"></div>
    <div class="provider-footer">
      <div class="provider-actions">
        <button class="btn" type="button" id="selectAll">Select all</button>
        <button class="btn quiet" type="button" id="clearAll">Clear selection</button>
      </div>
    </div>
  </section>

  <section class="panel" aria-labelledby="source-title">
    <div class="panel-heading">
      <div>
        <div class="panel-title" id="source-title">Source details</div>
        <div class="panel-description">Enter the GitHub repository and file path.</div>
      </div>
      <div class="section-index">02 / 03</div>
    </div>
    <div class="fields">
      <div class="field">
        <label for="username">GitHub username</label>
        <input id="username" autocomplete="off" spellcheck="false" placeholder="your-username">
      </div>
      <div class="field">
        <label for="repo">Repository name</label>
        <input id="repo" autocomplete="off" spellcheck="false" placeholder="your-repository">
      </div>
      <div class="field">
        <label for="branch">Branch</label>
        <input id="branch" autocomplete="off" spellcheck="false" value="main" placeholder="main">
      </div>
      <div class="field">
        <label for="filepath">File path</label>
        <input id="filepath" autocomplete="off" spellcheck="false" value="index.html" placeholder="index.html">
      </div>
      <div class="field count-field">
        <label for="count">Links per provider</label>
        <div class="count-control">
          <input id="count" type="number" inputmode="numeric" min="1" max="100000000" value="100">
          <button class="btn primary" type="button" id="generate">Generate links</button>
        </div>
        <div class="field-note">Maximum: 100,000,000</div>
      </div>
    </div>
  </section>

  <section class="panel" aria-labelledby="results-title">
    <div class="panel-heading">
      <div>
        <div class="panel-title" id="results-title">Generated links</div>
        <div class="panel-description">Browse by page or export the URLs as a text file.</div>
      </div>
      <div class="section-index">03 / 03</div>
    </div>
    <div id="resultsArea">
      <div class="empty">Your generated links will appear here.</div>
    </div>
  </section>

  <footer>
    <span>Nex-linkgen · Single-file utility</span>
    <span>Links are generated in your browser.</span>
  </footer>
</div>
<div class="toast" id="toast" role="status" aria-live="polite"></div>
<script>
(() => {
  "use strict";
  const providers = [
    { name: "cdn.jsdelivr.net", type: "jsdelivr" },
    { name: "fastly.jsdelivr.net", type: "jsdelivr" },
    { name: "gcore.jsdelivr.net", type: "jsdelivr" },
    { name: "quantil.jsdelivr.net", type: "jsdelivr" },
    { name: "jsdelivr.b-cdn.net", type: "jsdelivr" },
    { name: "originfastly.jsdelivr.net", type: "jsdelivr" },
    { name: "testingcf.jsdelivr.net", type: "jsdelivr" },
    { name: "rawcdn.jsdelivr.net", type: "jsdelivr" },
    { name: "unpkg.com", type: "npm" },
    { name: "esm.sh", type: "npm" },
    { name: "cdn.staticdelivr.com", type: "jsdelivr" },
    { name: "raw.githack.com", type: "githack" },
    { name: "raw.githubusercontent.com", type: "githubraw" }
  ];
  const $ = id => document.getElementById(id);
  const providerBox = $("providers");
  const resultsArea = $("resultsArea");
  const selectionInfo = $("selectionInfo");
  const toast = $("toast");
  let config = null;
  let currentPage = 0;
  let toastTimer = null;

  providers.forEach((provider, index) => {
    const label = document.createElement("label");
    label.className = "provider";
    const checkbox = document.createElement("input");
    checkbox.type = "checkbox";
    checkbox.value = String(index);
    checkbox.setAttribute("aria-label", provider.name);
    checkbox.addEventListener("change", () => {
      updateSelection();
    });
    const name = document.createElement("span");
    name.textContent = provider.name;
    label.append(checkbox, name);
    providerBox.appendChild(label);
  });

  function selectedProviders() {
    return [...providerBox.querySelectorAll('input[type="checkbox"]:checked')]
      .map(input => providers[Number(input.value)]);
  }

  function updateSelection() {
    const selected = selectedProviders();
    selectionInfo.textContent = `${selected.length} provider${selected.length === 1 ? "" : "s"} selected`;
  }

  function cleanPath(value) {
    return value.trim().replace(/^\/+/, "").split("/").filter(Boolean).map(encodeURIComponent).join("/");
  }

  function getSource() {
    const username = $("username").value.trim().replace(/^@/, "");
    const repo = $("repo").value.trim();
    const branch = $("branch").value.trim() || "main";
    const filepath = cleanPath($("filepath").value || "index.html");
    if (!username || !repo || !filepath) return null;
    return { username, repo, branch, filepath };
  }

  function makeUrl(provider, source, number) {
    const user = encodeURIComponent(source.username);
    const repo = encodeURIComponent(source.repo);
    const branch = encodeURIComponent(source.branch || "main");
    const file = source.filepath;
    let url;
    if (provider.type === "githack") {
      url = `https://raw.githack.com/${user}/${repo}/${branch}/${file}`;
    } else if (provider.type === "githubraw") {
      url = `https://raw.githubusercontent.com/${user}/${repo}/${branch}/${file}`;
    } else if (provider.type === "npm") {
      url = `https://${provider.name}/${user}/${repo}@${branch}/${file}`;
    } else {
      url = `https://${provider.name}/gh/${user}/${repo}@${branch}/${file}`;
    }
    return `${url}?${number}`;
  }


  function showToast(message) {
    toast.textContent = message;
    toast.classList.add("show");
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove("show"), 1900);
  }

  async function copyText(value, successMessage) {
    try {
      await navigator.clipboard.writeText(value);
      showToast(successMessage || "Copied to clipboard");
    } catch {
      const area = document.createElement("textarea");
      area.value = value;
      area.style.position = "fixed";
      area.style.opacity = "0";
      document.body.appendChild(area);
      area.select();
      const ok = document.execCommand("copy");
      area.remove();
      showToast(ok ? (successMessage || "Copied to clipboard") : "Copy failed — select the text manually");
    }
  }

  function getConfig() {
    const selected = selectedProviders();
    const source = getSource();
    const count = Number($("count").value);
    const pageSize = 1000;
    if (!selected.length) throw new Error("Select at least one provider.");
    if (!source) throw new Error("Enter a GitHub username, repository, and file path.");
    if (!Number.isSafeInteger(count) || count < 1 || count > 100000000) {
      throw new Error("Links per provider must be from 1 to 100,000,000.");
    }
    if (!Number.isSafeInteger(pageSize) || pageSize < 1 || pageSize > 10000) {
      throw new Error("Links per page must be from 1 to 10,000.");
    }
    return { selected, source, count, pageSize, total: selected.length * count };
  }

  function urlAt(globalIndex) {
    const providerIndex = Math.floor(globalIndex / config.count);
    const number = (globalIndex % config.count) + 1;
    return makeUrl(config.selected[providerIndex], config.source, number);
  }

  function renderResults() {
    if (!config) return;
    const pages = Math.ceil(config.total / config.pageSize);
    currentPage = Math.max(0, Math.min(currentPage, pages - 1));
    const start = currentPage * config.pageSize;
    const end = Math.min(start + config.pageSize, config.total);
    resultsArea.replaceChildren();

    const toolbar = document.createElement("div");
    toolbar.className = "toolbar";
    const count = document.createElement("div");
    count.className = "result-count";
    count.innerHTML = `<strong>${config.total.toLocaleString()}</strong> links · ${config.selected.length} providers · page ${currentPage + 1} of ${pages.toLocaleString()}`;
    const actions = document.createElement("div");
    actions.className = "result-actions";
    const copyPage = makeButton("Copy this page", () => {
      const text = buildText(start, end);
      copyText(text, `Copied ${end - start} links`);
    });
    const downloadPage = makeButton("Download this page", () => {
      downloadText(buildText(start, end), `Nex-linkgen-page-${currentPage + 1}.txt`);
    });
    const downloadAll = makeButton("Download all (.txt)", () => {
      if (config.total > 1000000 && !confirm(`This will create ${config.total.toLocaleString()} links in one text file and may use a lot of memory. Continue?`)) return;
      downloadAllText();
    }, "primary");
    actions.append(copyPage, downloadPage, downloadAll);
    toolbar.append(count, actions);
    resultsArea.appendChild(toolbar);

    const list = document.createElement("div");
    list.className = "results";
    for (let i = start; i < end; i++) {
      const row = document.createElement("div");
      row.className = "result";
      const number = document.createElement("span");
      number.className = "result-number";
      number.textContent = `#${(i + 1).toLocaleString()}`;
      const link = document.createElement("a");
      link.className = "result-url";
      link.href = urlAt(i);
      link.target = "_blank";
      link.rel = "noopener noreferrer";
      link.textContent = urlAt(i);
      link.title = "Open URL in a new tab";
      const copy = makeButton("Copy", () => copyText(link.href, "Link copied"));
      copy.classList.add("copy-one");
      row.append(number, link, copy);
      list.appendChild(row);
    }
    resultsArea.appendChild(list);

    const pager = document.createElement("div");
    pager.className = "pager";
    const range = document.createElement("div");
    range.className = "result-count";
    range.textContent = `Showing ${(start + 1).toLocaleString()}–${end.toLocaleString()} of ${config.total.toLocaleString()}`;
    const controls = document.createElement("div");
    controls.className = "pager-controls";
    const prev = makeButton("Previous", () => { currentPage--; renderResults(); });
    prev.disabled = currentPage === 0;
    const label = document.createElement("span");
    label.className = "page-label";
    label.textContent = `${(currentPage + 1).toLocaleString()} / ${pages.toLocaleString()}`;
    const next = makeButton("Next", () => { currentPage++; renderResults(); });
    next.disabled = currentPage >= pages - 1;
    controls.append(prev, label, next);
    pager.append(range, controls);
    resultsArea.appendChild(pager);

    const notice = document.createElement("div");
    notice.className = "notice";
    notice.textContent = "Note: unpkg.com and esm.sh are npm package CDNs, so they may not serve arbitrary GitHub repositories directly. Some alternate jsDelivr hostnames may also have different availability or URL behavior.";
    resultsArea.appendChild(notice);
  }

  function makeButton(text, handler, variant = "") {
    const button = document.createElement("button");
    button.type = "button";
    button.className = `btn ${variant}`.trim();
    button.textContent = text;
    button.addEventListener("click", handler);
    return button;
  }

  function buildText(start, end) {
    const lines = [];
    for (let i = start; i < end; i++) lines.push(urlAt(i));
    return lines.join("\n");
  }

  function downloadText(text, filename) {
    const blob = new Blob([text], { type: "text/plain;charset=utf-8" });
    const url = URL.createObjectURL(blob);
    const a = document.createElement("a");
    a.href = url;
    a.download = filename;
    document.body.appendChild(a);
    a.click();
    a.remove();
    setTimeout(() => URL.revokeObjectURL(url), 1500);
    showToast("Download started");
  }

  function downloadAllText() {
    if (!config) return;
    const chunks = [];
    const chunkSize = 10000;
    for (let start = 0; start < config.total; start += chunkSize) {
      const end = Math.min(start + chunkSize, config.total);
      chunks.push(buildText(start, end));
    }
    downloadText(chunks.join("\n") + "\n", `Nex-linkgen-all-${config.total}.txt`);
  }

  $("selectAll").addEventListener("click", () => {
    providerBox.querySelectorAll('input[type="checkbox"]').forEach(input => input.checked = true);
    updateSelection();
  });
  $("clearAll").addEventListener("click", () => {
    providerBox.querySelectorAll('input[type="checkbox"]').forEach(input => input.checked = false);
    updateSelection();
  });

  $("generate").addEventListener("click", () => {
    try {
      config = getConfig();
      currentPage = 0;
      renderResults();
      showToast(`Generated ${config.total.toLocaleString()} links`);
    } catch (error) {
      showToast(error.message);
    }
  });

  updateSelection();
})();
</script>
</body>
</html>
